# --- Discord (never commit real values) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Behavior ---
SILENCE_THRESHOLD_SECONDS=300
MIN_HUMANS=2
SWITCH_MARGIN=2
ELECTION_STABLE_SECONDS=20
MIN_DWELL_SECONDS=60
GRACE_SECONDS=0
NOTICE_COALESCE_MS=2000
EXEMPT_STREAMING=true
EXEMPT_CAMERA=true
EXEMPT_ROLE_IDS=
IGNORED_CHANNEL_IDS=
# Safety: log decisions only. Set to false once dry-run results look right.
DRY_RUN=true

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379
STATE_TTL_SECONDS=86400
METRICS_PORT=9464
LOG_LEVEL=info

# --- Optional AI phases ---
DECISION_POLICY=rules        # rules | shadow | model
ANTHROPIC_API_KEY=
LLM_MODEL=                   # verify current model IDs in Anthropic docs
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
